GROQ_API_KEY=your-existing-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
ENABLE_VISION=true
AUTH_SECRET=generate-a-long-random-secret-at-least-32-characters
POSTGRES_PASSWORD=generate-a-strong-database-password
DATABASE_URL=postgresql+psycopg://velorian:replace-with-the-same-database-password@postgres:5432/velorian
PUBLIC_ORIGIN=https://velorian.example.com
COOKIE_SECURE=true
APP_PORT=8080
FILE_STORAGE_DRIVER=s3
S3_ENDPOINT=https://your-s3-compatible-endpoint
S3_REGION=us-east-1
S3_BUCKET=velorian-private
S3_ACCESS_KEY=replace-with-storage-access-key
S3_SECRET_KEY=replace-with-storage-secret-key
KNOWLEDGE_SEARCH_DRIVER=text
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
