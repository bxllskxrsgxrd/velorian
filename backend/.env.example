MAX_OUTPUT_TOKENS=4096
AI_PROVIDER_MAX_RETRIES=2
GENERATION_TOTAL_TIMEOUT_SECONDS=600
GENERATION_FIRST_CHUNK_TIMEOUT_SECONDS=180
GENERATION_IDLE_TIMEOUT_SECONDS=120
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
OCR_LANGUAGES=rus+eng
KNOWLEDGE_RATING_THRESHOLD=4
KNOWLEDGE_SEARCH_DRIVER=text
FILE_STORAGE_DRIVER=local
