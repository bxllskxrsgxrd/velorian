GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_DEBUG_ERRORS=false
ENABLE_VISION=true
APP_ENV=development
AUTH_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
DATABASE_URL=sqlite:///./data/velorian.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./data/uploads
MAX_FILES=10
MAX_FILE_SIZE=10485760
MAX_TOTAL_FILE_SIZE=26214400
USER_MESSAGE_INLINE_CHAR_LIMIT=12000
MAX_INPUT_TOKENS=100000
CHAT_CONTEXT_BUDGET=100000
HISTORY_TOKEN_BUDGET=72000
MAX_OUTPUT_TOKENS=4096
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
OCR_LANGUAGES=rus+eng
KNOWLEDGE_RATING_THRESHOLD=4
KNOWLEDGE_SEARCH_DRIVER=text
FILE_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
